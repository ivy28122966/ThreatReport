      {
        "parameters": {
          "jsCode": "let text = $input.first().json.stdout.trim();\n\nif (text.startsWith('```')) {\n  text = text.replace(/^```(json)?/i, '').replace(/```$/, '').trim();\n}\n\nlet data;\ntry {\n  data = JSON.parse(text);\n} catch (e) {\n  throw new Error('Claude 回傳的內容不是合法 JSON，請檢查 stdout 原文: ' + text.slice(0, 500));\n}\n\n// 新增：偵測並剔除不屬於 schema 的雜訊欄位，同時記錄警告\nconst allowedKeys = ['date', 'stats', 'threat_level', 'sections', 'analyst_note'];\nconst extraKeys = Object.keys(data).filter(k => !allowedKeys.includes(k));\nif (extraKeys.length > 0) {\n  console.warn('⚠️ 偵測到非schema欄位，可能代表LLM呼叫過程有服務端錯誤混入：', extraKeys, data.error || '');\n  for (const k of extraKeys) delete data[k];\n}\n\nconst validSeverities = ['critical', 'high', 'medium', 'low', 'info'];\nif (!validSeverities.includes(data.threat_level)) {\n  throw new Error('threat_level 不合法: ' + data.threat_level);\n}\n\nreturn [{ json: data }];\n"
        },
